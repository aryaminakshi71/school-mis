  { month: "Aug", present: 92, absent: 8 },
  { month: "Sep", present: 88, absent: 12 },
  { month: "Oct", present: 94, absent: 6 },
  { month: "Nov", present: 91, absent: 9 },
  { month: "Dec", present: 89, absent: 11 },
  { month: "Jan", present: 95, absent: 5 },
];

const feesData = [
  { month: "Aug", collected: 45000, pending: 5000 },
  { month: "Sep", collected: 48000, pending: 3000 },
  { month: "Oct", collected: 52000, pending: 2000 },
  { month: "Nov", collected: 49000, pending: 4000 },
  { month: "Dec", collected: 51000, pending: 2500 },
  { month: "Jan", collected: 55000, pending: 1500 },

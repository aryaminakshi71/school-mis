{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "school-mis-web",
    "main": "./src/server.ts",
    "compatibility_date": "2025-01-10",
    "compatibility_flags": [
        "nodejs_compat",
        "nodejs_compat_populate_process_env"
    ],
    "assets": {
        "binding": "ASSETS"
    },
    "vars": {
        "NODE_ENV": "development"
    },
    "hyperdrive": [
        {
            "binding": "DATABASE",
            "id": "placeholder-create-hyperdrive-first",
            "localConnectionString": "postgresql://school_user:school_password@localhost:5432/school_mis"
        }
    ],
    "r2_buckets": [
        {
            "binding": "BUCKET",
            "bucket_name": "school-mis-assets"
        }
    ],
    "kv_namespaces": [
        {
            "binding": "CACHE",
            "id": "placeholder-kv-id"
        }
    ],
    "dev": {
        "port": 3010
    }
}
    "@sentry/node": "^8.0.0",
    "@upstash/ratelimit": "^2.0.7",
    "dd-trace": "^5.0.0",
    "better-auth": "^1.4.12",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.7.10",
    "nanoid": "^5.0.9",
    "pg": "^8.11.3",
    "postgres": "^3.4.8",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@playwright/test": "^1.40.0",

{
  "name": "@school/api",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test __tests__/unit",
    "test:unit": "bun test __tests__/unit",
    "test:integration": "bun test __tests__/integration --timeout 60000",
    "test:e2e": "playwright test",
    "test:coverage": "bun test --coverage",
    "start": "bun src/server.ts",
    "db:push": "cd ../../packages/storage && bunx drizzle-kit push --force",
    "test:e2e:setup": "bun run scripts/setup-e2e-schema.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "@orpc/openapi": "^1.13.4",
    "@orpc/server": "^1.13.4",
    "@orpc/zod": "^1.13.4",
    "@scalar/hono-api-reference": "^0.6.0",
    "@school/auth": "workspace:*",
    "@school/env": "workspace:*",
    "@school/storage": "workspace:*",
    "@sentry/cloudflare": "^10.36.0",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.36.1",
    "better-auth": "^1.4.18",
    "dd-trace": "^5.0.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.7",
    "nanoid": "^5.0.9",
    "openai": "^6.18.0",
    "pg": "^8.11.3",
    "postgres": "^3.4.8",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^22.19.2",
    "@types/pg": "^8.10.9",
    "bun-types": "^1.3.6",
    "typescript": "^5.9.3"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["bun-types"],
    "paths": {
      "@school/env": ["../../packages/env/src"],
      "@school/env/*": ["../../packages/env/src/*"],
      "@school/storage": ["../../packages/storage/src"],
      "@school/storage/*": ["../../packages/storage/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "../web", "src/__tests__", "**/*.test.ts"]
}

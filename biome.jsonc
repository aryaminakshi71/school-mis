{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "include": ["**"],
    "ignore": [
      "node_modules",
      "dist",
      "build",
      ".next",
      ".wrangler",
      ".turbo",
      ".output",
      "coverage",
      "playwright-report",
      "test-results",
      "test-results.json",
      "tsconfig.tsbuildinfo",
      "**/*.webm"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "nursery": {
        "useSortedClasses": "warn"
      },
      "correctness": {
        "noUnusedImports": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      }
    }
  }
}

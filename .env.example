# ============================================================================
# School MIS Environment Variables
# ============================================================================

# IMPORTANT: Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control

# ============================================================================
# OPERATIONAL CONFIG
# ============================================================================

NODE_ENV=development

# ============================================================================
# SITE CONFIG
# ============================================================================

VITE_PUBLIC_SITE_URL=http://localhost:3015
API_URL=http://localhost:3016
# Web dev server port (PORT) and API port (API_PORT) must differ.
PORT=3015
API_PORT=3016

# ============================================================================
# DATABASE (Neon PostgreSQL) - REQUIRED
# ============================================================================

# Step 1: Create account at https://console.neon.tech
# Step 2: Create a new project
# Step 3: Go to Connection Details and copy your connection string
# Step 4: Replace the placeholder below with your actual connection string

# Format: postgresql://username:password@ep-xxx.region.neon.tech/database_name?sslmode=require
# Example: postgresql://john:AbCdEf123@ep-something-12345.us-east-1.aws.neon.tech/school_mis?sslmode=require

DATABASE_URL="postgresql://[YOUR_NEON_USERNAME]:[YOUR_NEON_PASSWORD]@[YOUR_NEON_HOST].neon.tech/school_mis?sslmode=require"

# ============================================================================
# AUTH (JWT) - Security Keys
# ============================================================================

# Generated secure keys - replace with your own in production
JWT_SECRET="BO/swZChUXCQjqNHs3nQ8zn/Rnsg1OHWkiiIKKK9dWg0="
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="xl2plSBSG31ZTpjTTl54ekj2MRZrd3fwNf78j4NV4Dk="
REFRESH_TOKEN_EXPIRES_IN="30d"

# ============================================================================
# BETTER AUTH - Social Login
# ============================================================================

# Generate a secure random string for better-auth (min 32 chars)
BETTER_AUTH_SECRET="your-better-auth-secret-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3015"

# Custom base path (default: /api/auth)
# BETTER_AUTH_BASE_PATH="/api/auth"

# Trusted origins for OAuth (comma-separated, includes BETTER_AUTH_URL)
# BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3015,https://your-domain.workers.dev"

# Google OAuth - Get credentials at https://console.cloudflare.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth - Get credentials at https://github.com/settings/developers
# Callback URL for GitHub: http://localhost:3015/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ============================================================================
# REDIS (Upstash) - optional for caching/sessions
# ============================================================================

# Get free Redis at https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================================================
# EMAIL (SMTP) - REQUIRED for notifications
# ============================================================================

# Option 1: SendGrid (Recommended)
# Get API key at https://app.sendgrid.com/settings/api_keys
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="SG.your-sendgrid-api-key-here"
FROM_EMAIL="noreply@yourschool.com"
FROM_NAME="School MIS"

# Option 2: Gmail (requires App Password)
# Enable 2FA and create app password at https://myaccount.google.com/homepasswords
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-digit-app-password"
# FROM_EMAIL="your-email@gmail.com"

# Option 3: Other SMTP providers (Mailgun, Postmark, AWS SES, etc.)
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT="587"
# SMTP_USER="postmaster@yourdomain.mailgun.org"
# SMTP_PASS="your-mailgun-password"

# ============================================================================
# SMS (Twilio) - REQUIRED for SMS notifications
# ============================================================================

# Step 1: Create account at https://www.twilio.com
# Step 2: Get a phone number from Twilio
# Step 3: Copy Account SID, Auth Token, and Phone Number from Console

# Your Twilio credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"  # Your Twilio phone number
TWILIO_MESSAGING_SERVICE_SID=""

# ============================================================================
# WHATSAPP (Twilio WhatsApp) - REQUIRED for WhatsApp notifications
# ============================================================================

# WhatsApp requires separate setup in Twilio
# Step 1: Go to Twilio Console > Messaging > Try WhatsApp
# Step 2: Send a message to the sandbox number to opt-in
# Step 3: Use your WhatsApp Business number or sandbox

TWILIO_WHATSAPP_NUMBER="whatsapp:+1234567890"  # Your WhatsApp Business number
TWILIO_WHATSAPP_SANDBOX_NUMBER="+14155238886"  # Twilio Sandbox (for testing)

# ============================================================================
# OTHER SMS PROVIDERS (Backup options for India)
# ============================================================================

# MSG91 (Popular in India)
# Get API key at https://msg91.com
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="SCHOOL"

# Fast2SMS (India)
# Get API key at https://www.fast2sms.com
FAST2SMS_API_KEY=""

# ============================================================================
# NOTIFICATION PREFERENCES
# ============================================================================

ENABLE_EMAIL_NOTIFICATIONS="true"
ENABLE_SMS_NOTIFICATIONS="true"
ENABLE_WHATSAPP_NOTIFICATIONS="true"

# ============================================================================
# DEFAULT LOGIN CREDENTIALS (Development)
# ============================================================================

# Admin: admin@school.com / admin123
# Teacher: teacher@school.com / teacher123
# Student: student@school.com / student123
# Parent: parent@school.com / parent123
# Accountant: accountant@school.com / accountant123

# ── Transactional email (Resend) ─────────────────────────────────────────────
# Get a key at https://resend.com/api-keys. Without it, emails are logged to
# the console instead of sent (safe for local dev and demos).
RESEND_API_KEY=
EMAIL_FROM="noreply@yourdomain.com"

# ── Read replica (optional) ──────────────────────────────────────────────────
# Point analytics/dashboard reads at a Neon read replica so they don't compete
# with writes. Leave empty to use the primary for everything.
DATABASE_READ_URL=

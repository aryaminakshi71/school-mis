# ============================================================================
# School MIS Environment Variables
# Copy this file to .env and fill in the values
# ============================================================================

# ============================================================================
# OPERATIONAL CONFIG
# ============================================================================

NODE_ENV=development

# ============================================================================
# SITE CONFIG
# ============================================================================

# Public URL for OAuth callbacks and email links
VITE_PUBLIC_SITE_URL=http://localhost:3001

# API URL
API_URL=http://localhost:3000

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================

# Local development database
DATABASE_URL="postgresql://postgres@localhost:5432/school_mis"

# ============================================================================
# AUTH (Better Auth)
# ============================================================================

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-better-auth-secret-at-least-32-chars"

# Google OAuth (optional)
# Get from Google Cloud Console: https://console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (optional)
# Get from GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ============================================================================
# REDIS (Upstash) - optional, for caching
# ============================================================================

# Get from Upstash console: https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================================================
# ANALYTICS - optional
# ============================================================================

VITE_PUBLIC_POSTHOG_KEY=""
VITE_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ============================================================================
# CLOUDFLARE (optional)
# ============================================================================

CLOUDFLARE_ACCOUNT_ID=""

# R2 Storage (optional)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
